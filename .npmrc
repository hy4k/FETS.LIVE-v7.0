; Dependencies allowed to run install scripts.
; .npmrc takes precedence over pnpm-workspace.yaml, so this is the list that
; actually applies. Keep it in step with onlyBuiltDependencies in that file.
; Without @google/genai and protobufjs here, `pnpm install` exits 1 on
; ERR_PNPM_IGNORED_BUILDS and takes `pnpm run build` down with it.
only-built-dependencies[]=@google/genai
only-built-dependencies[]=core-js
only-built-dependencies[]=cpu-features
only-built-dependencies[]=esbuild
only-built-dependencies[]=msw
only-built-dependencies[]=protobufjs
only-built-dependencies[]=sharp
only-built-dependencies[]=ssh2
